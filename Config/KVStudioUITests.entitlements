<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The runner starts real kv-server processes and reads the repo's build products; the app it
	     drives is unsandboxed, and a driver confined more tightly than its subject cannot drive it. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
